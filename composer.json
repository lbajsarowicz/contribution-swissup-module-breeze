{
    "name": "swissup/module-breeze",
    "description": "Performant Magento Frontend",
    "type": "magento2-module",
    "version": "2.33.2",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "swissup/module-core": "^1.13.1",
        "swissup/module-rtl": "^1.3.4"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Swissup\\Breeze\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
